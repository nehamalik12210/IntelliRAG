# ═══════════════════════════════════════
# IntelliRAG Configuration
# ═══════════════════════════════════════
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ═══════════════════════════════════════
# LLM Provider API Keys (pick at least one)
# ═══════════════════════════════════════
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# ═══════════════════════════════════════
# Default LLM (used when no override is specified)
# ═══════════════════════════════════════
DEFAULT_LLM_PROVIDER=groq
DEFAULT_LLM_MODEL=llama-3.1-8b-instant

# ═══════════════════════════════════════
# Embeddings (local, no API key needed)
# ═══════════════════════════════════════
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# ═══════════════════════════════════════
# Retrieval Settings
# ═══════════════════════════════════════
CHUNK_SIZE=512
CHUNK_OVERLAP=50
TOP_K_RETRIEVAL=20
TOP_K_RERANK=5
RERANKER_ENABLED=false
HYBRID_FUSION_METHOD=rrf

# ═══════════════════════════════════════
# Vector Database
# ═══════════════════════════════════════
# If Qdrant is not running, the app auto-falls back to in-memory mode
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# ═══════════════════════════════════════
# Storage
# ═══════════════════════════════════════
SQLITE_DB_PATH=./data/intellirag.db
UPLOAD_DIR=./data/uploads

# ═══════════════════════════════════════
# Server
# ═══════════════════════════════════════
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
